# ============================================================================
# vfat-position-watchdog — configuración
# Copia este fichero a .env y rellena los valores:  cp .env.example .env
# ============================================================================

# Wallet(s) EVM a vigilar. Se admite una lista separada por comas (máx. 5,
# límite del tool get_wallet_portfolio del MCP).
WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# --- Telegram ---------------------------------------------------------------
# Token del bot (lo da @BotFather al crear el bot) y chat destino.
# Para saber tu chat_id escribe a tu bot y abre:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Ciclo de vigilancia ------------------------------------------------------
# Segundos entre comprobaciones (180 = 3 minutos).
CHECK_INTERVAL_SECONDS=180

# Filtro opcional de chains por chainId EVM, separadas por comas (vacío = todas).
# Ejemplo: CHAIN_IDS=8453,42161
CHAIN_IDS=

# --- Comportamiento de los avisos ---------------------------------------------
# true  = avisa solo cuando una posición PASA a fuera de rango (y al volver).
# false = avisa en cada ejecución mientras siga fuera de rango (por defecto).
ALERT_ONLY_CHANGES=false
# Avisar también cuando una posición vuelve a entrar en rango.
ALERT_ON_RECOVERY=true

# Mensaje de bienvenida al arrancar el demonio.
NOTIFY_ON_START=true
# Aviso si una comprobación falla (MCP caído, red, etc.).
NOTIFY_ON_ERROR=true

# "Latido" periódico con el resumen de posiciones, en horas (0 = desactivado).
# Ejemplo: 24 = un resumen al día aunque todo esté en rango.
HEARTBEAT_HOURS=0

# Fichero adicional de log (vacío = solo stdout, útil con systemd/nohup).
LOG_FILE=

# URL del MCP de vfat (por defecto el endpoint público, sin API key).
MCP_URL=https://mcp.vfat.io/mcp

# ============================================================================
# Interfaz web (web_server.py) — ver README, sección "Modo web"
# ============================================================================
# Dirección de escucha. 127.0.0.1 = solo local (usa un proxy inverso para
# exponerla); 0.0.0.0 = accesible desde la red (activa WEB_PASSWORD).
WEB_HOST=127.0.0.1
WEB_PORT=8000

# Contraseña de acceso a la interfaz web (vacía = sin contraseña; recomendado
# solo en local). Si expones el puerto o lo publicas, PONLA.
WEB_PASSWORD=

# Arrancar el bucle de vigilancia al levantar el servidor web (true/false).
WEB_AUTOSTART=true
